# Pinned native sources for jRTL releases. Sourced by the build scripts and read
# by the GitHub workflows. To move to a new upstream release, change these values
# and open a pull request.
#
# RTLSDR_REF is the upstream tag to build. Upstream tags use a capital V, such as
# V1.4.0, and the library itself reports no version, so RTLSDR_VERSION records
# the release the tag names. It is also the jRTL version.
RTLSDR_REPOSITORY=https://github.com/rtlsdrblog/rtl-sdr-blog.git
RTLSDR_REF=V1.4.0
RTLSDR_VERSION=1.4.0
LIBUSB_VERSION=1.0.30
LIBUSB_TARBALL_SHA256=fea36f34f9156400209595e300840767ab1a385ede1dc7ee893015aea9c6dbaf
LIBUSB_WINDOWS_7Z_SHA256=7fb1dfec805b97983763d7d0ae244320da12add1003d4249c96cc4d586398c79
